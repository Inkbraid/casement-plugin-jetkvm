{
  "format": "casement-plugin",
  "version": 1,
  "id": "jetkvm",
  "name": "JetKVM",
  "description": "JetKVM devices on your network",
  "icon": "icon.png",
  "program": "casement-jetkvm.exe",
  "args": [],
  "homepage": "https://github.com/Inkbraid/casement-plugin-jetkvm",
  "capabilities": ["password"],
  "connections": [
    {
      "scheme": "jetkvm",
      "name": "JetKVM device",
      "fields": [
        { "name": "host", "label": "Device", "part": "host", "type": "text", "required": true, "placeholder": "192.168.1.50" },
        { "name": "port", "label": "Port", "part": "port", "type": "number", "placeholder": "80" },
        { "name": "tls", "label": "HTTPS", "part": "query", "type": "flag" },
        { "name": "fingerprint", "label": "Certificate SHA-256", "part": "query", "type": "text", "placeholder": "3A:5F:…" }
      ]
    }
  ]
}
